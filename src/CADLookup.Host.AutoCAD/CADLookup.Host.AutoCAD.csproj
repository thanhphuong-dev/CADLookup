<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoCADManagedDir Condition="'$(AutoCADManagedDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2023</AutoCADManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CADLookup.Core\CADLookup.Core.csproj" />
    <ProjectReference Include="..\CADLookup.UI\CADLookup.UI.csproj" />
    <Reference Include="AcMgd"><HintPath>$(AutoCADManagedDir)\AcMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADManagedDir)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADManagedDir)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AdWindows"><HintPath>$(AutoCADManagedDir)\AdWindows.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
