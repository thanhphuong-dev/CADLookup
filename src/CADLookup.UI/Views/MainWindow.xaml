<UserControl x:Class="CADLookup.UI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:CADLookup.UI.Localization"
        xmlns:mvvm="clr-namespace:CADLookup.UI.Mvvm"
        xmlns:vm="clr-namespace:CADLookup.UI.ViewModels"
        xmlns:controls="clr-namespace:CADLookup.UI.Controls"
        MinHeight="640" MinWidth="1020"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <UserControl.InputBindings>
        <KeyBinding Key="F6" Command="{Binding SelectInDrawingCommand}" CommandParameter="{x:Null}" />
        <KeyBinding Key="F7" Command="{Binding ZoomToObjectCommand}" CommandParameter="{x:Null}" />
        <KeyBinding Key="F8" Command="{Binding ToggleHighlightCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="F" Command="{Binding OpenSearchDialogCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:LocalizationService x:Key="FallbackLocalization" />
            <mvvm:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

            <!-- Default DataGrid Style: BASED ON HandyControl default DataGrid -->
            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="RowHeight" Value="30" />
                <Setter Property="ColumnHeaderHeight" Value="32" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            </Style>

            <!-- Default ComboBox Style: BASED ON HandyControl default ComboBox -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <ContextMenu x:Key="ObjectTreeContextMenu"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="{Binding Data.Localization[OpenReference], Source={StaticResource ViewModelProxy}}"
                          Command="{Binding Data.OpenPropertyCommand, Source={StaticResource ViewModelProxy}}"
                          CommandParameter="{Binding}" />
                <Separator />
                <MenuItem Header="{Binding Data.Localization[SelectInDrawing], Source={StaticResource ViewModelProxy}}"
                          Command="{Binding Data.SelectInDrawingCommand, Source={StaticResource ViewModelProxy}}"
                          CommandParameter="{Binding}"
                          ToolTip="{Binding Data.Localization[SelectInDrawingHint], Source={StaticResource ViewModelProxy}}" />
                <MenuItem Header="{Binding Data.Localization[ZoomToObject], Source={StaticResource ViewModelProxy}}"
                          Command="{Binding Data.ZoomToObjectCommand, Source={StaticResource ViewModelProxy}}"
                          CommandParameter="{Binding}"
                          ToolTip="{Binding Data.Localization[ZoomToObjectHint], Source={StaticResource ViewModelProxy}}" />
                <Separator />
                <MenuItem Header="{Binding Data.Localization[CopyHandle], Source={StaticResource ViewModelProxy}}"
                          Command="{Binding Data.CopyHandleCommand, Source={StaticResource ViewModelProxy}}"
                          CommandParameter="{Binding}" />
            </ContextMenu>

            <ContextMenu x:Key="PropertyRowContextMenu"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="{Binding Data.Localization[Copy], Source={StaticResource ViewModelProxy}}"
                          Command="{Binding Data.CopyPropertyValueCommand, Source={StaticResource ViewModelProxy}}"
                          CommandParameter="{Binding}" />
                <MenuItem Header="{Binding Data.Localization[CopyPath], Source={StaticResource ViewModelProxy}}"
                          Command="{Binding Data.CopyPropertyPathCommand, Source={StaticResource ViewModelProxy}}"
                          CommandParameter="{Binding}" />
                <Separator />
                <MenuItem Header="{Binding Data.Localization[SelectInDrawing], Source={StaticResource ViewModelProxy}}"
                          Command="{Binding Data.SelectInDrawingCommand, Source={StaticResource ViewModelProxy}}"
                          CommandParameter="{Binding}"
                          ToolTip="{Binding Data.Localization[SelectInDrawingHint], Source={StaticResource ViewModelProxy}}" />
                <MenuItem Header="{Binding Data.Localization[ZoomToObject], Source={StaticResource ViewModelProxy}}"
                          Command="{Binding Data.ZoomToObjectCommand, Source={StaticResource ViewModelProxy}}"
                          CommandParameter="{Binding}"
                          ToolTip="{Binding Data.Localization[ZoomToObjectHint], Source={StaticResource ViewModelProxy}}" />
                <Separator />
                <MenuItem Header="{Binding Data.Localization[OpenReference], Source={StaticResource ViewModelProxy}}"
                          Command="{Binding Data.OpenPropertyCommand, Source={StaticResource ViewModelProxy}}"
                          CommandParameter="{Binding}" />
            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- Top Toolbar Header (Clean, Light/Dark integrated, NO PURPLE) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Active host and drawing -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SecondaryRegionBrush}" BorderBrush="{DynamicResource SecondaryBorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource DarkSuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SecondaryRegionBrush}" BorderBrush="{DynamicResource SecondaryBorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Localization[Document]}" Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DocumentName}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Controls (Using HandyControl standard styles) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding Localization[Select]}" Command="{Binding SelectCommand}"
                            Style="{StaticResource ButtonPrimary}" Margin="3,0" Height="32" Padding="14,0"
                            ToolTip="{Binding Localization[FormSelectHint]}" />
                    <Button Content="{Binding Localization[SnoopDatabase]}" Command="{Binding SnoopDatabaseCommand}"
                            Style="{StaticResource ButtonSuccess}" Margin="3,0" Height="32" Padding="12,0"
                            ToolTip="{Binding Localization[FormSnoopHint]}" />
                    <Button Content="{Binding Localization[Refresh]}" Command="{Binding RefreshCommand}"
                            Style="{StaticResource ButtonDefault}" Margin="3,0" Height="32" Padding="10,0"
                            ToolTip="{Binding Localization[FormRefreshHint]}" />

                    <!-- Whole-drawing search dialog -->
                    <Button Command="{Binding OpenSearchDialogCommand}" Height="32" Padding="12,0" Margin="3,0"
                            ToolTip="{Binding Localization[SearchDrawingHint]}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SupportsDatabaseSearch}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌕" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Localization[SearchDrawing]}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Quick Handle Lookup SearchBar -->
                    <hc:SearchBar Width="154" Height="32" Margin="7,0,5,0"
                                  Text="{Binding HandleQuery, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource SearchBarPlus}"
                                  ToolTip="{Binding Localization[FormHandleHint]}"
                                  hc:InfoElement.Placeholder="{Binding Localization[HandlePlaceholder]}"
                                  hc:InfoElement.ShowClearButton="True"
                                  Command="{Binding LookupHandleCommand}" />

                    <!-- Theme Toggle Button -->
                    <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource ButtonDefault}"
                            Height="32" Margin="3,0" MinWidth="70" ToolTip="{Binding Localization[FormThemeHint]}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ThemeIcon}" Margin="0,0,5,0" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ThemeText}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Language Toggle Button -->
                    <Button Command="{Binding LanguageCommand}" Style="{StaticResource ButtonDefault}"
                            Height="32" Margin="3,0" MinWidth="44" ToolTip="{Binding Localization[FormLanguageHint]}">
                        <TextBlock Text="{Binding Language}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Status Bar (Clean, no duplicate CADLookup branding) -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource DarkPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Margin="10,10,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="230" MaxWidth="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Objects List / Hierarchy in HandyControl Card -->
            <hc:Card Grid.Column="0" hc:BorderElement.CornerRadius="6"
                     Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <!-- Header with Object Count Badge -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{Binding Localization[Objects]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <hc:Badge HorizontalAlignment="Right" Value="{Binding VisibleObjects.Count}" Style="{StaticResource BadgePrimary}" ShowBadge="True" />
                        </Grid>
                        <!-- Grouping Selector & Expand/Collapse ButtonGroup -->
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding GroupByOptions}" SelectedItem="{Binding SelectedGroupBy, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" ToolTip="{Binding Localization[GroupBy]}" />
                            <hc:ButtonGroup Grid.Column="1" Margin="6,0,0,0">
                                <Button Command="{Binding ExpandAllTreeCommand}" Content="+" Style="{StaticResource ButtonDefault}" Padding="8,2" ToolTip="{Binding Localization[ExpandAll]}" FontSize="11" />
                                <Button Command="{Binding CollapseAllTreeCommand}" Content="-" Style="{StaticResource ButtonDefault}" Padding="8,2" ToolTip="{Binding Localization[CollapseAll]}" FontSize="11" />
                            </hc:ButtonGroup>
                        </Grid>

                        <!-- Filter SearchBar using HandyControl SearchBarPlus -->
                        <hc:SearchBar Height="30"
                                      Text="{Binding ObjectFilter, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SearchBarPlus}"
                                      ToolTip="{Binding Localization[FilterObjects]}"
                                      hc:InfoElement.Placeholder="{Binding Localization[FilterObjects]}"
                                      hc:InfoElement.ShowClearButton="True" />
                    </StackPanel>

                    <!-- Hierarchical Object TreeView -->
                    <Grid>
                        <TreeView ItemsSource="{Binding ObjectTreeRoots}"
                                  SelectedItemChanged="ObjectTreeSelectedItemChanged"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:ObjectTreeNode}" ItemsSource="{Binding Children}">
                                    <Border x:Name="NodeSurface" Padding="5,3" Margin="0,1" CornerRadius="3" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CountBadge}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" FontFamily="Consolas" Margin="8,0,2,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                                            <Setter TargetName="NodeSurface" Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="1" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="ContextMenu" Value="{StaticResource ObjectTreeContextMenu}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="190" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VisibleObjects.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Localization[SelectObjectHint]}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </hc:Card>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" Width="6" Background="Transparent" Cursor="SizeWE" />

            <!-- Right Panel: Object Summary & Inspection Tabs -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Target Object Summary in HandyControl Card (CLEAN, NO REDUNDANCY) -->
                <hc:Card Grid.Row="0" hc:BorderElement.CornerRadius="6"
                         Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Object Type & Actions -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedTypeName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                <Border Background="{DynamicResource LightPrimaryBrush}" CornerRadius="4" Padding="7,2" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedHandle}" Foreground="{DynamicResource DarkPrimaryBrush}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" />
                                </Border>
                                <Border CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource LightSuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedState}" Value="Erased">
                                                    <Setter Property="Background" Value="{DynamicResource LightDangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedState}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource DarkSuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedState}" Value="Erased">
                                                        <Setter Property="Foreground" Value="{DynamicResource DarkDangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Action buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding SelectInDrawingCommand}" CommandParameter="{x:Null}" Height="30" Padding="10,0" Margin="3,0"
                                        ToolTip="{Binding Localization[SelectInDrawingHint]}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SupportsSelectInDrawing}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="F6" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Localization[SelectInDrawing]}" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ZoomToObjectCommand}" CommandParameter="{x:Null}" Height="30" Padding="10,0" Margin="3,0"
                                        ToolTip="{Binding Localization[ZoomToObjectHint]}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SupportsZoomToObject}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="F7" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Localization[ZoomToObject]}" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ToggleHighlightCommand}" Height="30" Padding="10,0" Margin="3,0"
                                        ToolTip="{Binding Localization[HighlightInDrawingHint]}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SupportsTransientHighlight}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding HighlightIcon}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Localization[HighlightInDrawing]}" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Content="{Binding Localization[Copy]}" Command="{Binding CopyCommand}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="3,0" />
                                <Button Content="{Binding Localization[CopyPath]}" Command="{Binding CopyPathCommand}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="3,0" />
                                <Button Content="{Binding Localization[Export]}" Command="{Binding ExportCommand}" Style="{StaticResource ButtonPrimary}" Height="30" Padding="12,0" Margin="3,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Divider line -->
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource SecondaryBorderBrush}" Margin="0,6,0,6" />

                        <!-- Row 2: Metadata & History Navigation in a clean horizontal strip -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Drawing -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Localization[Document]}" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding SelectedDocumentId}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </StackPanel>

                            <!-- ObjectId -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Localization[ObjectId]}" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding SelectedNativeId}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontFamily="Consolas" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            </StackPanel>

                            <!-- MemberPath -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{Binding Localization[Path]}" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding SelectedReferencePath}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- History Navigation < > + recent objects dropdown -->
                            <hc:ButtonGroup Grid.Column="5" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button Command="{Binding BackCommand}" Content="&lt;" Style="{StaticResource ButtonDefault}" ToolTip="{Binding Localization[Back]}" Padding="9,3" Height="28" />
                                <Button Command="{Binding ForwardCommand}" Content="&gt;" Style="{StaticResource ButtonDefault}" ToolTip="{Binding Localization[Forward]}" Padding="9,3" Height="28" />
                            </hc:ButtonGroup>
                            <Button Grid.Column="6" Content="≡" Style="{StaticResource ButtonDefault}" Height="28" Padding="9,3" Margin="6,0,0,0"
                                    VerticalAlignment="Center" ToolTip="{Binding Localization[History]}">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                 ItemsSource="{Binding History}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Header" Value="{Binding DisplayName}" />
                                                <Setter Property="Command" Value="{Binding DataContext.NavigateHistoryCommand, Source={StaticResource ViewModelProxy}}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Grid>
                </hc:Card>

                <!-- Inspection Detail Card (Properties & Geometry) in HandyControl Card -->
                <hc:Card Grid.Row="2" hc:BorderElement.CornerRadius="6"
                         Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DockPanel Margin="10">
                        <!-- Toolbar: Category filter, status filter, search -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Localization[Properties]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <Border Background="{DynamicResource LightPrimaryBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FilterSummary}" Foreground="{DynamicResource DarkPrimaryBrush}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Localization[PropertyDescription]}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Filters: Group toggle, Source Group, Status, and SearchBarPlus -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ToggleGroupPropertiesCommand}" Content="{Binding GroupPropertiesIcon}"
                                        Style="{StaticResource ButtonDefault}" Width="32" Height="32" Padding="0" Margin="0,0,6,0"
                                        FontSize="12" ToolTip="{Binding Localization[GroupProperties]}" />
                                <ComboBox ItemsSource="{Binding PropertySources}" SelectedItem="{Binding SelectedPropertySource, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="32" VerticalContentAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding Localization[AllSources]}" />
                                <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="32" VerticalContentAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding Localization[StatusFilter]}" />
                                <hc:SearchBar Width="180" Height="30"
                                              Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource SearchBarPlus}"
                                              ToolTip="{Binding Localization[Search]}"
                                              hc:InfoElement.Placeholder="{Binding Localization[Search]}"
                                              hc:InfoElement.ShowClearButton="True" />
                            </StackPanel>
                        </Grid>

                        <!-- TabControl styled with HandyControl TabControlCapsule -->
                        <TabControl Style="{StaticResource TabControlCapsule}" Margin="0,6,0,0">
                            <!-- Tab 1: Properties Table (Using HandyControl Default DataGrid Style) -->
                            <TabItem Header="{Binding Localization[Properties]}">
                                <Grid Margin="0,8,0,0">
                                    <DataGrid Style="{StaticResource {x:Type DataGrid}}"
                                              ItemsSource="{Binding PropertiesView}"
                                              SelectedItem="{Binding SelectedProperty}"
                                              MouseDoubleClick="PropertyDoubleClick">
                                        <DataGrid.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="GroupItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="GroupItem">
                                                                    <StackPanel>
                                                                        <Border Background="{DynamicResource LightPrimaryBrush}" CornerRadius="4" Padding="8,3" Margin="0,4,0,1">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                                                                           Foreground="{DynamicResource DarkPrimaryBrush}" VerticalAlignment="Center" />
                                                                                <Border Background="{DynamicResource RegionBrush}" CornerRadius="3" Padding="5,0" Margin="7,0,0,0">
                                                                                    <TextBlock Text="{Binding ItemCount}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"
                                                                                               Foreground="{DynamicResource DarkPrimaryBrush}" VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ItemsPresenter />
                                                                    </StackPanel>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </DataGrid.GroupStyle>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Setter Property="ContextMenu" Value="{StaticResource PropertyRowContextMenu}" />
                                                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                                <Setter Property="ToolTipService.InitialShowDelay" Value="650" />
                                                <Setter Property="ToolTipService.ShowDuration" Value="20000" />
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{Binding Data.Localization[Name], Source={StaticResource ViewModelProxy}}" Binding="{Binding Name}" Width="1.4*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Padding" Value="6,0" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="{Binding Data.Localization[TypeHeader], Source={StaticResource ViewModelProxy}}" Binding="{Binding Type}" Width="1.1*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Padding" Value="6,0" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="{Binding Data.Localization[ValueHeader], Source={StaticResource ViewModelProxy}}" Binding="{Binding Value}" Width="2.8*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="Consolas" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Padding" Value="6,0" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="{Binding Data.Localization[SourceHeader], Source={StaticResource ViewModelProxy}}" Binding="{Binding Source}" Width="1.1*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Padding" Value="6,0" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="{Binding Data.Localization[StatusHeader], Source={StaticResource ViewModelProxy}}" Width="1.2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource LightSuccessBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDeferred}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource LightWarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource LightDangerBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsLimited}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsUnsupported}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="{DynamicResource DarkSuccessBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDeferred}" Value="True">
                                                                                    <Setter Property="Fill" Value="{DynamicResource DarkWarningBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                                    <Setter Property="Fill" Value="{DynamicResource DarkDangerBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsLimited}" Value="True">
                                                                                    <Setter Property="Fill" Value="{DynamicResource DarkPrimaryBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsUnsupported}" Value="True">
                                                                                    <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DarkSuccessBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDeferred}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DarkWarningBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DarkDangerBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsLimited}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsUnsupported}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Empty State Message -->
                                    <TextBlock Text="{Binding Localization[EmptyProperties]}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProperties}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </TabItem>

                            <!-- Tab 2: Geometry preview + summary -->
                            <TabItem Header="{Binding Localization[Geometry]}">
                                <DockPanel Margin="0,8,0,0">
                                    <Border DockPanel.Dock="Top" Height="200" Background="{DynamicResource SecondaryRegionBrush}"
                                            BorderBrush="{DynamicResource SecondaryBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Margin="0,0,0,8">
                                        <controls:GeometryPreview Figures="{Binding CurrentFigures}"
                                                                  EmptyText="{Binding Localization[NoGeometry]}" />
                                    </Border>
                                    <DataGrid Style="{StaticResource {x:Type DataGrid}}"
                                              ItemsSource="{Binding Geometry}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{Binding Data.Localization[GeometryKind], Source={StaticResource ViewModelProxy}}" Binding="{Binding Kind}" Width="1*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Padding" Value="6,0" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="{Binding Data.Localization[Summary], Source={StaticResource ViewModelProxy}}" Binding="{Binding Summary}" Width="3.5*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="Consolas" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Padding" Value="6,0" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </hc:Card>

                <!-- Get-started dashboard: overlays the right panel until an object is inspected -->
                <Border Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource BackgroundBrush}" IsHitTestVisible="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCurrentObject}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" TextBlock.TextAlignment="Center">
                        <Border Width="54" Height="54" CornerRadius="14" Background="{DynamicResource DarkPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="C" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Localization[GetStarted]}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Localization[GetStartedHint]}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />

                        <!-- Command guide (no duplicate buttons: actions live in the toolbar above) -->
                        <Border Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16,10" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource LightPrimaryBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,4,12,4">
                                    <TextBlock Text="CADLOOKUP" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DarkPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Localization[GuideInspect]}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Left" />
                                <Border Grid.Column="0" Grid.Row="1" Background="{DynamicResource LightPrimaryBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,4,12,4">
                                    <TextBlock Text="CADLOOKUPSELECT" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DarkPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Localization[GuideSelect]}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Left" />
                                <Border Grid.Column="0" Grid.Row="2" Background="{DynamicResource LightPrimaryBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,4,12,4">
                                    <TextBlock Text="CADLOOKUPFIND" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DarkPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding Localization[GuideSearch]}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Left" />
                                <Border Grid.Column="0" Grid.Row="3" Background="{DynamicResource LightPrimaryBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,4,12,4">
                                    <TextBlock Text="CADLOOKUPSNOOPDB" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DarkPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding Localization[GuideSnoop]}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Left" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Localization[ShortcutsHint]}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
