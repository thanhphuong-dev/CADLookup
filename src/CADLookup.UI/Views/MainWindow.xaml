<UserControl x:Class="CADLookup.UI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:CADLookup.UI.Localization"
        xmlns:mvvm="clr-namespace:CADLookup.UI.Mvvm"
        xmlns:vm="clr-namespace:CADLookup.UI.ViewModels"
        MinHeight="640" MinWidth="1020"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:LocalizationService x:Key="FallbackLocalization" />
            <mvvm:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

            <!-- Dynamic theme brushes with fallbacks -->
            <SolidColorBrush x:Key="AppBgBrush" Color="#FFF4F6FA" />
            <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE2E8F0" />
            <SolidColorBrush x:Key="CardSubtleBgBrush" Color="#FFF8FAFC" />
            <SolidColorBrush x:Key="CardSubtleBorderBrush" Color="#FFE2E8F0" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1E293B" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF64748B" />
            <SolidColorBrush x:Key="HeaderBgBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="HeaderBorderBrush" Color="#FFE2E8F0" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
            <SolidColorBrush x:Key="DataGridBgBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="DataGridRowBgBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="DataGridAltRowBgBrush" Color="#FFF8FAFC" />
            <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#FFE2E8F0" />
            <SolidColorBrush x:Key="TagBgBrush" Color="#FFEFF6FF" />
            <SolidColorBrush x:Key="TagTextBrush" Color="#FF1D4ED8" />

            <!-- Default DataGrid Style: BASED ON HandyControl default DataGrid -->
            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="RowHeight" Value="34" />
                <Setter Property="ColumnHeaderHeight" Value="36" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            </Style>

            <!-- Default ComboBox Style: BASED ON HandyControl default ComboBox -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- Top Toolbar Header (Clean, Light/Dark integrated, NO PURPLE) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Branding & Active Drawing Info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="C" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="CADLookup" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                    </StackPanel>
                    <Border Background="{DynamicResource CardSubtleBgBrush}" BorderBrush="{DynamicResource CardSubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DocumentName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Controls (Using HandyControl standard styles) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding Localization[Select]}" Command="{Binding SelectCommand}"
                            Style="{StaticResource ButtonPrimary}" Margin="3,0" Height="30" Padding="12,0" />
                    <Button Content="{Binding Localization[SnoopDatabase]}" Command="{Binding SnoopDatabaseCommand}"
                            Style="{StaticResource ButtonSuccess}" Margin="3,0" Height="30" Padding="12,0"
                            ToolTip="{Binding Localization[SnoopDatabaseHint]}" />
                    <Button Content="{Binding Localization[Refresh]}" Command="{Binding RefreshCommand}"
                            Style="{StaticResource ButtonDefault}" Margin="3,0" Height="30" Padding="10,0" />

                    <!-- Quick Handle Lookup SearchBar -->
                    <hc:SearchBar Width="150" Height="30" Margin="6,0,4,0"
                                  Text="{Binding HandleQuery, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource SearchBarPlus}"
                                  ToolTip="{Binding Localization[HandlePlaceholder]}"
                                  hc:InfoElement.Placeholder="{Binding Localization[HandlePlaceholder]}"
                                  hc:InfoElement.ShowClearButton="True"
                                  Command="{Binding LookupHandleCommand}" />

                    <!-- Theme Toggle Button -->
                    <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource ButtonDefault}"
                            Height="30" Margin="3,0" MinWidth="54" ToolTip="{Binding Localization[Theme]}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ThemeIcon}" Margin="0,0,4,0" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ThemeText}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Language Toggle Button -->
                    <Button Command="{Binding LanguageCommand}" Style="{StaticResource ButtonDefault}"
                            Height="30" Margin="3,0" MinWidth="44" ToolTip="Switch Language (VI/EN)">
                        <TextBlock Text="{Binding Language}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Status Bar (Clean, no duplicate CADLookup branding) -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Margin="12,12,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="240" MaxWidth="460" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Objects List / Hierarchy in HandyControl Card -->
            <hc:Card Grid.Column="0" Effect="{StaticResource EffectShadow2}"
                     Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <!-- Header with Object Count Badge -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{Binding Localization[Objects]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <hc:Badge HorizontalAlignment="Right" Value="{Binding VisibleObjects.Count}" Style="{StaticResource BadgePrimary}" ShowBadge="True" />
                        </Grid>
                        <TextBlock Text="{Binding Localization[SelectObjectHint]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" />

                        <!-- Grouping Selector & Expand/Collapse ButtonGroup -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding GroupByOptions}" SelectedItem="{Binding SelectedGroupBy, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" ToolTip="{Binding Localization[GroupBy]}" />
                            <hc:ButtonGroup Grid.Column="1" Margin="6,0,0,0">
                                <Button Command="{Binding ExpandAllTreeCommand}" Content="+" Style="{StaticResource ButtonDefault}" Padding="8,2" ToolTip="{Binding Localization[ExpandAll]}" FontSize="11" />
                                <Button Command="{Binding CollapseAllTreeCommand}" Content="-" Style="{StaticResource ButtonDefault}" Padding="8,2" ToolTip="{Binding Localization[CollapseAll]}" FontSize="11" />
                            </hc:ButtonGroup>
                        </Grid>

                        <!-- Filter SearchBar using HandyControl SearchBarPlus -->
                        <hc:SearchBar Height="30"
                                      Text="{Binding ObjectFilter, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SearchBarPlus}"
                                      ToolTip="{Binding Localization[FilterObjects]}"
                                      hc:InfoElement.Placeholder="{Binding Localization[FilterObjects]}"
                                      hc:InfoElement.ShowClearButton="True" />
                    </StackPanel>

                    <!-- Hierarchical Object TreeView -->
                    <TreeView ItemsSource="{Binding ObjectTreeRoots}"
                              SelectedItemChanged="ObjectTreeSelectedItemChanged"
                              BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:ObjectTreeNode}" ItemsSource="{Binding Children}">
                                <Border Padding="6,4" Margin="0,1" CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource TagBgBrush}" CornerRadius="6" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CountBadge}" Foreground="{DynamicResource TagTextBrush}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="1" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </hc:Card>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" Width="6" Background="Transparent" Cursor="SizeWE" />

            <!-- Right Panel: Object Summary & Inspection Tabs -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Target Object Summary in HandyControl Card (CLEAN, NO REDUNDANCY) -->
                <hc:Card Grid.Row="0" Effect="{StaticResource EffectShadow2}"
                         Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Object Type & Actions -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedTypeName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                <Border Background="{DynamicResource TagBgBrush}" CornerRadius="4" Padding="7,2" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedHandle}" Foreground="{DynamicResource TagTextBrush}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" />
                                </Border>
                                <Border CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1510B981" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedState}" Value="Erased">
                                                    <Setter Property="Background" Value="#15EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedState}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FF10B981" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedState}" Value="Erased">
                                                        <Setter Property="Foreground" Value="#FFEF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Action buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding Localization[Copy]}" Command="{Binding CopyCommand}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="3,0" />
                                <Button Content="{Binding Localization[CopyPath]}" Command="{Binding CopyPathCommand}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="3,0" />
                                <Button Content="{Binding Localization[Export]}" Command="{Binding ExportCommand}" Style="{StaticResource ButtonPrimary}" Height="30" Padding="12,0" Margin="3,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Divider line -->
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource CardSubtleBorderBrush}" Margin="0,10,0,10" />

                        <!-- Row 2: Metadata & History Navigation in a clean horizontal strip -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Drawing -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Localization[Document]}" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding SelectedDocumentId}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </StackPanel>

                            <!-- ObjectId -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Localization[ObjectId]}" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding SelectedNativeId}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontFamily="Consolas" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            </StackPanel>

                            <!-- MemberPath -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{Binding Localization[Path]}" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding SelectedReferencePath}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- History Navigation < > -->
                            <hc:ButtonGroup Grid.Column="5" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button Command="{Binding BackCommand}" Content="&lt;" Style="{StaticResource ButtonDefault}" ToolTip="{Binding Localization[Back]}" Padding="9,3" Height="28" />
                                <Button Command="{Binding ForwardCommand}" Content="&gt;" Style="{StaticResource ButtonDefault}" ToolTip="{Binding Localization[Forward]}" Padding="9,3" Height="28" />
                            </hc:ButtonGroup>
                        </Grid>
                    </Grid>
                </hc:Card>

                <!-- Inspection Detail Card (Properties & Geometry) in HandyControl Card -->
                <hc:Card Grid.Row="2" Effect="{StaticResource EffectShadow2}"
                         Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <DockPanel Margin="14">
                        <!-- Toolbar: Category filter, status filter, search -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Localization[Properties]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Border Background="{DynamicResource TagBgBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FilterSummary}" Foreground="{DynamicResource TagTextBrush}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Localization[PropertyDescription]}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Filters: Source Group, Status, and SearchBarPlus -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding PropertySources}" SelectedItem="{Binding SelectedPropertySource, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="30" VerticalContentAlignment="Center" Margin="0,0,6,0" ToolTip="Lọc theo nhóm thuộc tính" />
                                <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" VerticalContentAlignment="Center" Margin="0,0,6,0" ToolTip="Lọc theo trạng thái đọc" />
                                <hc:SearchBar Width="180" Height="30"
                                              Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource SearchBarPlus}"
                                              ToolTip="{Binding Localization[Search]}"
                                              hc:InfoElement.Placeholder="{Binding Localization[Search]}"
                                              hc:InfoElement.ShowClearButton="True" />
                            </StackPanel>
                        </Grid>

                        <!-- TabControl styled with HandyControl TabControlCapsule -->
                        <TabControl Style="{StaticResource TabControlCapsule}" Margin="0,6,0,0">
                            <!-- Tab 1: Properties Table (Using HandyControl Default DataGrid Style) -->
                            <TabItem Header="{Binding Localization[Properties]}">
                                <Grid Margin="0,8,0,0">
                                    <DataGrid Style="{StaticResource {x:Type DataGrid}}"
                                              ItemsSource="{Binding Properties}"
                                              SelectedItem="{Binding SelectedProperty}"
                                              MouseDoubleClick="PropertyDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{Binding Data.Localization[Name], Source={StaticResource ViewModelProxy}}" Binding="{Binding Name}" Width="1.4*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Padding" Value="6,0" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="{Binding Data.Localization[TypeHeader], Source={StaticResource ViewModelProxy}}" Binding="{Binding Type}" Width="1.1*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Padding" Value="6,0" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="{Binding Data.Localization[ValueHeader], Source={StaticResource ViewModelProxy}}" Binding="{Binding Value}" Width="2.8*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="Consolas" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Padding" Value="6,0" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="{Binding Data.Localization[SourceHeader], Source={StaticResource ViewModelProxy}}" Binding="{Binding Source}" Width="1.1*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Padding" Value="6,0" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="{Binding Data.Localization[StatusHeader], Source={StaticResource ViewModelProxy}}" Width="1.2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1510B981" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDeferred}" Value="True">
                                                                            <Setter Property="Background" Value="#15F59E0B" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                            <Setter Property="Background" Value="#15EF4444" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="#FF10B981" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDeferred}" Value="True">
                                                                                    <Setter Property="Fill" Value="#FFF59E0B" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                                    <Setter Property="Fill" Value="#FFEF4444" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#FF059669" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDeferred}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#FFD97706" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#FFDC2626" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Empty State Message -->
                                    <TextBlock Text="{Binding Localization[EmptyProperties]}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProperties}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </TabItem>

                            <!-- Tab 2: Geometry Summary (Using HandyControl Default DataGrid Style) -->
                            <TabItem Header="{Binding Localization[Geometry]}">
                                <DataGrid Style="{StaticResource {x:Type DataGrid}}"
                                          ItemsSource="{Binding Geometry}" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding Data.Localization[GeometryKind], Source={StaticResource ViewModelProxy}}" Binding="{Binding Kind}" Width="1*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="6,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="{Binding Data.Localization[Summary], Source={StaticResource ViewModelProxy}}" Binding="{Binding Summary}" Width="3.5*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="Consolas" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="6,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </hc:Card>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
