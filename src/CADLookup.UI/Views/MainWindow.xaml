<UserControl x:Class="CADLookup.UI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:CADLookup.UI.Localization"
        xmlns:mvvm="clr-namespace:CADLookup.UI.Mvvm"
        MinHeight="560" MinWidth="900" Background="#FFF4F6FA" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:LocalizationService x:Key="FallbackLocalization" />
            <mvvm:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF2864D7" />
            <SolidColorBrush x:Key="MutedBrush" Color="#FF728096" />
            <Style TargetType="Button">
                <Setter Property="Padding" Value="13,7" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeight" Value="36" />
                <Setter Property="ColumnHeaderHeight" Value="38" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="White" />
                <Setter Property="RowBackground" Value="White" />
                <Setter Property="AlternatingRowBackground" Value="#FFF8FAFD" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            </Style>
            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#FF17243A" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#FF2864D7" Margin="0,0,13,0">
                        <TextBlock Text="C" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CADLookup" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HostName}" Foreground="#FFB9C7DA" FontSize="12" ToolTip="{Binding HostCapabilities}" />
                    </StackPanel>
                    <Border Background="#FF253752" CornerRadius="5" Padding="10,6" Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DocumentName}" Foreground="#FFE3EAF4" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding Localization[Select]}" Command="{Binding SelectCommand}" Background="#FF2864D7" Foreground="White" BorderThickness="0" />
                    <Button Content="{Binding Localization[Refresh]}" Command="{Binding RefreshCommand}" />
                    <TextBox Width="125" Height="31" Padding="8,4" VerticalContentAlignment="Center" Text="{Binding HandleQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Localization[HandlePlaceholder]}" hc:InfoElement.Placeholder="{Binding Localization[HandlePlaceholder]}" />
                    <Button Content="{Binding Localization[Go]}" Command="{Binding LookupHandleCommand}" />
                    <Button Content="{Binding Language}" Command="{Binding LanguageCommand}" MinWidth="48" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#FFE5EAF1" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="#FF59677B" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="CADLookup  ·  Object Inspector" Foreground="#FF98A3B4" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Margin="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="9" BorderBrush="#FFE5EAF1" BorderThickness="1">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="{Binding Localization[Objects]}" FontSize="16" FontWeight="SemiBold" Foreground="#FF1F2D42" VerticalAlignment="Center" />
                            <hc:Badge Grid.Column="1" HorizontalAlignment="Right" Value="{Binding Objects.Count}" Style="{DynamicResource BadgePrimary}" />
                        </Grid>
                        <TextBlock Text="{Binding Localization[SelectObjectHint]}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
                        <TextBox Height="32" Margin="0,10,0,0" Padding="9,4" VerticalContentAlignment="Center" Text="{Binding ObjectFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Localization[FilterObjects]}" hc:InfoElement.Placeholder="{Binding Localization[FilterObjects]}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding VisibleObjects}" SelectionChanged="ObjectSelectionChanged" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,9" Margin="0,0,0,5" CornerRadius="6" BorderBrush="#FFEDF0F5" BorderThickness="1" Background="#FFFBFCFE">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold" Foreground="#FF29384D" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Localization[Handle]}" Style="{StaticResource CaptionStyle}" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding Handle}" Foreground="#FF2864D7" FontFamily="Consolas" FontSize="11" />
                                            <TextBlock Text="{Binding Layer}" Foreground="#FF728096" FontSize="11" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="95" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" Width="5" Background="#FFD8DFE9" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="9" BorderBrush="#FFE5EAF1" BorderThickness="1" Padding="18,15">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Localization[Inspector]}" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding ObjectSummary}" FontSize="18" FontWeight="SemiBold" Foreground="#FF1F2D42" Margin="0,5,0,9" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FFEAF1FF" CornerRadius="4" Padding="8,4" Margin="0,0,7,0"><TextBlock Text="{Binding SelectedHandle}" Foreground="#FF275AB5" FontFamily="Consolas" FontSize="11" /></Border>
                                <Border Background="#FFF1F3F7" CornerRadius="4" Padding="8,4"><TextBlock Text="{Binding SelectedTypeName}" Foreground="#FF59677B" FontSize="11" /></Border>
                                <Border Background="#FFFDF2E0" CornerRadius="4" Padding="8,4" Margin="7,0,0,0"><TextBlock Text="{Binding SelectedState}" Foreground="#FF9A6511" FontSize="11" /></Border>
                            </StackPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Localization[Document]}" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding SelectedDocumentId}" Foreground="#FF43536A" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Localization[ObjectId]}" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding SelectedNativeId}" Foreground="#FF43536A" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Localization[Path]}" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding SelectedReferencePath}" Foreground="#FF43536A" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <Button Content="‹" Command="{Binding BackCommand}" ToolTip="{Binding Localization[Back]}" Padding="7,2" Margin="0,0,3,0" />
                                <Button Content="›" Command="{Binding ForwardCommand}" ToolTip="{Binding Localization[Forward]}" Padding="7,2" Margin="0,0,7,0" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="500">
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding DisplayName}" Command="{Binding DataContext.NavigateHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,3" Margin="0,0,4,0" FontSize="10" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding Localization[Copy]}" Command="{Binding CopyCommand}" />
                            <Button Content="{Binding Localization[CopyPath]}" Command="{Binding CopyPathCommand}" />
                            <Button Content="{Binding Localization[Export]}" Command="{Binding ExportCommand}" Background="#FF2864D7" Foreground="White" BorderThickness="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="White" CornerRadius="9" BorderBrush="#FFE5EAF1" BorderThickness="1" Padding="14">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Localization[Properties]}" FontWeight="SemiBold" FontSize="16" Foreground="#FF1F2D42" />
                                <TextBlock Text="{Binding Localization[PropertyDescription]}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150" Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center" ItemsSource="{Binding PropertySources}" SelectedItem="{Binding SelectedPropertySource, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Width="270" Height="34" Padding="10,5" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Localization[Search]}" hc:InfoElement.Placeholder="{Binding Localization[Search]}" />
                        </Grid>
                        <TabControl BorderThickness="0" Background="Transparent">
                            <TabItem Header="{Binding Localization[Properties]}">
                                <Grid Margin="0,6,0,0">
                                    <DataGrid ItemsSource="{Binding Properties}" SelectedItem="{Binding SelectedProperty}" SelectionMode="Single" MouseDoubleClick="PropertyDoubleClick">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding PlacementTarget.DataContext.Localization[Copy], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Command="{Binding PlacementTarget.DataContext.CopyPropertyValueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="{Binding PlacementTarget.DataContext.Localization[CopyPath], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Command="{Binding PlacementTarget.DataContext.CopyPropertyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="{Binding PlacementTarget.DataContext.Localization[OpenReference], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Command="{Binding PlacementTarget.DataContext.OpenPropertyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{Binding Data.Localization[Name], Source={StaticResource ViewModelProxy}}" Binding="{Binding Name}" Width="1.5*" />
                                            <DataGridTextColumn Header="{Binding Data.Localization[TypeHeader], Source={StaticResource ViewModelProxy}}" Binding="{Binding Type}" Width="1.2*" />
                                            <DataGridTextColumn Header="{Binding Data.Localization[ValueHeader], Source={StaticResource ViewModelProxy}}" Binding="{Binding Value}" Width="3*" />
                                            <DataGridTextColumn Header="{Binding Data.Localization[SourceHeader], Source={StaticResource ViewModelProxy}}" Binding="{Binding Source}" Width="1.1*" />
                                            <DataGridTextColumn Header="{Binding Data.Localization[StatusHeader], Source={StaticResource ViewModelProxy}}" Binding="{Binding Status}" Width="1*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="{Binding Localization[EmptyProperties]}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProperties}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </TabItem>
                            <TabItem Header="{Binding Localization[Geometry]}">
                                <DataGrid ItemsSource="{Binding Geometry}" Margin="0,6,0,0">
                                    <DataGrid.Columns><DataGridTextColumn Header="{Binding Data.Localization[GeometryKind], Source={StaticResource ViewModelProxy}}" Binding="{Binding Kind}" Width="1*"/><DataGridTextColumn Header="{Binding Data.Localization[Summary], Source={StaticResource ViewModelProxy}}" Binding="{Binding Summary}" Width="4*"/></DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
